# Bearer token shared by the server and all clients. Generate: make token
API_TOKEN=change-me-to-a-long-random-string

# Host port for web + API (API is served under /api, including for iOS). Not published in production.
PORT=8420

# Production server only: layers docker-compose.prod.yml (no published port, joins the host's
# ingress), so plain `docker compose` and every make target run in production mode there.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
