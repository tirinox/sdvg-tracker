        "today": "2026-09-22",
        "warn_below": 50,
        "versions": [
          { "id": "0192f0a0-0000-7000-8000-000000000301", "routine_id": "0192f0a0-0000-7000-8000-000000000101", "effective_from": "2026-09-01", "weekdays": 127, "archived": false, "hlc": "1790000000000-0000-aaaaaaaaaaaaaaaa" }
        ],
        "checks": [
          { "routine_id": "0192f0a0-0000-7000-8000-000000000101", "date": "2026-09-20", "status": "skipped" },
          { "routine_id": "0192f0a0-0000-7000-8000-000000000101", "date": "2026-09-23", "status": "done" }
        ]
      },
      "expect": {
        "routines": {
          "0192f0a0-0000-7000-8000-000000000101": { "from": null, "done": 0, "total": 0, "percent": null, "warning": false }
        }
      }
    },
