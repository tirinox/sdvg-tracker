          {
            "kind": "routine",
            "id": "r1",
            "title": "Зарядка",
            "done_today": false
          }
        ],
        "title": "зарядка!",
        "limit": 3
      },
      "expect": {
        "status": "taken",
        "item": "r1"
      }
    },
