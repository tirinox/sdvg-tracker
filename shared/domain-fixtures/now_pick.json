{
  "description": "Top of the Now screen. Takes open items (not done, not skipped) of the day, given in day order. Candidates are items with score > 0 and high-priority items whose time has come (started, see time_started; no started = true). They are ranked by priority (high, normal, low; no priority = normal; high that has not started ranks as normal), then by score descending, then by item_order, and the first max of them are taken. If fewer than min are taken, the rest of the open items follow in day order until there are min. expect.ids lists the picked ids in screen order.",
  "cases": [
    {
      "name": "high priority goes above a stuck task",
      "input": {
        "max": 7,
        "min": 5,
        "items": [
          {
            "id": "high",
            "priority": "high",
            "done": false,
            "skipped": false,
            "time": null,
            "sort_key": "a0",
            "score": 0
          },
          {
            "id": "stuck",
            "priority": "normal",
            "done": false,
            "skipped": false,
            "time": null,
            "sort_key": "a1",
            "score": 70
          },
          {
            "id": "plain-1",
            "priority": "normal",
            "done": false,
            "skipped": false,
            "time": null,
            "sort_key": "a2",
            "score": 0
          },
          {
            "id": "plain-2",
            "priority": "normal",
            "done": false,
            "skipped": false,
            "time": null,
            "sort_key": "a3",
            "score": 0
          },
          {
            "id": "low-due",
            "priority": "low",
            "done": false,
            "skipped": false,
            "time": null,
            "sort_key": "a4",
            "score": 80
          },
          {
            "id": "plain-3",
            "priority": "normal",
            "done": false,
            "skipped": false,
            "time": null,
            "sort_key": "a5",
            "score": 0
          }
        ]
      },
      "expect": {
        "ids": [
          "high",
          "stuck",
          "low-due",
          "plain-1",
          "plain-2"
        ]
      }
    },
    {
      "name": "done and skipped are never picked",
      "input": {
        "max": 7,
        "min": 5,
        "items": [
          {
            "id": "high-done",
            "priority": "high",
            "done": true,
            "skipped": false,
            "time": null,
            "sort_key": "a0",
            "score": 0
          },
          {
            "id": "skipped",
            "priority": "high",
            "done": false,
            "skipped": true,
            "time": null,
            "sort_key": "a1",
            "score": 0
          },
          {
            "id": "now",
            "priority": "normal",
            "done": false,
            "skipped": false,
            "time": null,
            "sort_key": "a2",
            "score": 50
          }
        ]
      },
      "expect": {
        "ids": [
          "now"
        ]
      }
    },
