{
  "description": "Logical today = local date of (now - day_start_hour). 'now' is local wall time.",
  "cases": [
    {
      "name": "2026-09-22T10:00 with day start 4:00",
      "input": {
        "now": "2026-09-22T10:00",
        "day_start_hour": 4
      },
      "expect": {
        "date": "2026-09-22"
      }
    },
    {
      "name": "2026-09-23T01:30 with day start 4:00",
      "input": {
        "now": "2026-09-23T01:30",
        "day_start_hour": 4
      },
      "expect": {
        "date": "2026-09-22"
      }
    },
    {
      "name": "2026-09-23T04:00 with day start 4:00",
      "input": {
        "now": "2026-09-23T04:00",
        "day_start_hour": 4
      },
      "expect": {
        "date": "2026-09-23"
      }
    },
    {
      "name": "2026-09-23T03:59 with day start 4:00",
      "input": {
        "now": "2026-09-23T03:59",
        "day_start_hour": 4
      },
      "expect": {
        "date": "2026-09-22"
      }
    },
    {
      "name": "2026-09-23T00:00 with day start 0:00",
      "input": {
        "now": "2026-09-23T00:00",
        "day_start_hour": 0
      },
      "expect": {
        "date": "2026-09-23"
      }
    },
    {
      "name": "2027-01-01T02:00 with day start 4:00",
      "input": {
        "now": "2027-01-01T02:00",
        "day_start_hour": 4
      },
      "expect": {
        "date": "2026-12-31"
      }
    }
  ]
}
