{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sync.schema.json",
  "title": "Sync protocol",
  "$defs": {
    "change": {
      "type": "object",
      "properties": {
        "entity": {
          "enum": [
            "task",
            "task_move",
            "routine",
            "routine_version",
            "routine_check",
            "settings"
          ]
        },
        "id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "const": "settings"
            }
          ]
        },
        "fields": {
          "type": "object",
          "minProperties": 1
        },
        "clocks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/hlc"
          },
          "minProperties": 1
        }
      },
      "required": [
        "entity",
        "id",
        "fields",
        "clocks"
      ],
      "additionalProperties": false,
      "description": "A set of field values with their clocks. Push: any subset of fields. Pull: full row. Keys of fields and clocks must match."
    },
    "request": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "default": 1000
        },
        "server_id": {
          "$ref": "common.schema.json#/$defs/uuid",
          "description": "The database the client last synced with. If the server's differs, it answers 409 server_changed and applies nothing. Omitted before the first sync."
        },
        "epoch": {
          "$ref": "common.schema.json#/$defs/uuid",
          "description": "The epoch from the client's last response. If the server's differs, the database was restored from a backup and the response has rewind = true."
        }
      },
      "required": [
        "cursor",
        "changes"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "server_id": {
          "$ref": "common.schema.json#/$defs/uuid",
          "description": "Identifies the data set. It changes when the database is emptied or replaced; clients must then ask the user before sending it anything (see server_changed)."
        },
        "epoch": {
          "$ref": "common.schema.json#/$defs/uuid",
          "description": "Changes when the database is restored from a backup; server_id stays."
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "rewind": {
          "type": "boolean",
          "description": "The database is behind the client (restored from a backup, or the request cursor is ahead of it): changes start from the beginning, and the client must push every row it has."
        }
      },
      "required": [
        "server_id",
        "epoch",
        "cursor",
        "changes",
        "has_more",
        "rewind"
      ],
      "additionalProperties": false
    },
    "info": {
      "type": "object",
      "description": "GET /api/sync/info: which data set this is, without pushing anything.",
      "properties": {
        "server_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "epoch": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Rows per entity; entities without rows are left out"
        }
      },
      "required": [
        "server_id",
        "epoch",
        "counts"
      ],
      "additionalProperties": false
    },
    "server_changed": {
      "type": "object",
      "description": "detail of the 409 answer to a request whose server_id is not this database's. Nothing was applied.",
      "properties": {
        "error": {
          "const": "server_changed"
        },
        "server_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "epoch": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Rows per entity; entities without rows are left out"
        }
      },
      "required": [
        "error",
        "server_id",
        "epoch",
        "counts"
      ],
      "additionalProperties": false
    }
  }
}
